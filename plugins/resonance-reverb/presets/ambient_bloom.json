{
  "format": "resonance.preset",
  "format_version": 1,
  "id": "ambient-bloom",
  "plugin": { "id": "com.resonance.reverb" },
  "meta": {
    "name": "Ambient Bloom",
    "author": "Resonance",
    "description": "A hall at full build: the tail swells in over 300 ms behind a 60 ms pre-delay and holds for 6 s, faint reflections, extra random modulation and a 180 Hz return HPF so the low end stays clear. A slow-blooming wash for drones and ambient beds, not a discreet space.",
    "category": "Creative",
    "instrument": ["synth", "strings", "guitar"],
    "genres": ["ambient", "cinematic", "post-metal"],
    "character": ["evolving", "lush", "wide", "airy"],
    "tags": ["hall", "long-decay", "bloom", "swell"]
  },
  "state": {
    "encoding": "resonance-json",
    "doc": {
      "params": {
        "predelay": 60.0,
        "er_level": 0.15,
        "er_time": 0.65,
        "size": 0.85,
        "decay": 6.0,
        "damping": 5000.0,
        "diffusion": 0.90,
        "mod_rate": 1.5,
        "mod_depth": 0.60,
        "width": 1.0,
        "mix": 0.50,
        "freeze": 0,
        "wet_hpf_on": 1,
        "wet_hpf_freq": 180.0,
        "wet_lpf_on": 0,
        "wet_lpf_freq": 10000.0,
        "wet_filter_slope": 0,
        "duck_amount": 0.0,
        "duck_threshold": -30.0,
        "duck_attack": 15.0,
        "duck_release": 200.0,
        "er_tail_balance": 0.3,
        "algorithm": 4,
        "low_decay_mult": 1.2,
        "low_xover": 250.0,
        "high_decay_mult": 0.55,
        "predelay_sync": 0,
        "decay_sync": 0,
        "tail_build": 1.0,
        "shimmer_pitch": 0,
        "shimmer_amount": 0.3,
        "nl_shape": 0,
        "nl_length": 300.0,
        "spring_tension": 0.5,
        "spring_drip": 0.3
      }
    }
  }
}

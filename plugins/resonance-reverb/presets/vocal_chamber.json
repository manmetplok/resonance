{
  "format": "resonance.preset",
  "format_version": 1,
  "id": "vocal-chamber",
  "plugin": { "id": "com.resonance.reverb" },
  "meta": {
    "name": "Vocal Chamber",
    "author": "Resonance",
    "description": "Warm, dense echo chamber for a lead vocal: Chamber at 1.4 s, bass decay 1.4x, treble 0.45x above 6 kHz, no modulation, 20 ms pre-delay and a 250 Hz return HPF so the warmth stays out of the low end. 20% mix.",
    "category": "Track",
    "instrument": ["vocal", "lead-vocal", "backing-vocal"],
    "genres": ["singer-songwriter", "folk", "indie", "americana"],
    "character": ["warm", "lush", "vintage"],
    "tags": ["chamber", "vocal", "medium-decay", "vintage"]
  },
  "state": {
    "encoding": "resonance-json",
    "doc": {
      "params": {
        "predelay": 20.0,
        "er_level": 0.35,
        "er_time": 0.45,
        "size": 0.45,
        "decay": 1.4,
        "damping": 6000.0,
        "diffusion": 0.85,
        "mod_rate": 0.5,
        "mod_depth": 0.0,
        "width": 1.0,
        "mix": 0.2,
        "freeze": 0,
        "wet_hpf_on": 1,
        "wet_hpf_freq": 250.0,
        "wet_lpf_on": 0,
        "wet_lpf_freq": 10000.0,
        "wet_filter_slope": 0,
        "duck_amount": 0.0,
        "duck_threshold": -30.0,
        "duck_attack": 15.0,
        "duck_release": 200.0,
        "er_tail_balance": 0.0,
        "algorithm": 3,
        "low_decay_mult": 1.4,
        "low_xover": 250.0,
        "high_decay_mult": 0.45,
        "predelay_sync": 0,
        "decay_sync": 0,
        "tail_build": 0.5
      }
    }
  }
}

{
  "format": "resonance.preset",
  "format_version": 1,
  "id": "octave-halo",
  "plugin": { "id": "com.resonance.reverb" },
  "meta": {
    "name": "Octave Halo",
    "author": "Resonance",
    "description": "A 6 s hall that blooms an octave up behind ambient pads and clean guitars: Shimmer at +12 with a third of the loop shifted, 40 ms pre-delay and a 200 Hz return HPF. A halo, not a wash: keep it in the back layer.",
    "category": "Creative",
    "instrument": ["synth", "keys", "electric-guitar", "guitar"],
    "genres": ["ambient", "post-metal", "indie", "cinematic"],
    "character": ["airy", "lush", "evolving", "bright"],
    "tags": ["shimmer", "octave", "pads", "back-layer"]
  },
  "state": {
    "encoding": "resonance-json",
    "doc": {
      "params": {
        "predelay": 40.0,
        "er_level": 0.25,
        "er_time": 0.6,
        "size": 0.7,
        "decay": 6.0,
        "damping": 8000.0,
        "diffusion": 0.85,
        "mod_rate": 0.8,
        "mod_depth": 0.40,
        "width": 1.0,
        "mix": 0.35,
        "freeze": 0,
        "wet_hpf_on": 1,
        "wet_hpf_freq": 200.0,
        "wet_lpf_on": 0,
        "wet_lpf_freq": 10000.0,
        "wet_filter_slope": 0,
        "duck_amount": 0.0,
        "duck_threshold": -30.0,
        "duck_attack": 15.0,
        "duck_release": 200.0,
        "er_tail_balance": 0.0,
        "algorithm": 8,
        "low_decay_mult": 1.0,
        "low_xover": 250.0,
        "high_decay_mult": 0.6,
        "predelay_sync": 0,
        "decay_sync": 0,
        "tail_build": 0.6,
        "shimmer_pitch": 0,
        "shimmer_amount": 0.35,
        "nl_shape": 0,
        "nl_length": 300.0,
        "spring_tension": 0.5,
        "spring_drip": 0.3
      }
    }
  }
}

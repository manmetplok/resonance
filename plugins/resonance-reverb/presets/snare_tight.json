{
  "format": "resonance.preset",
  "format_version": 1,
  "id": "snare-tight",
  "plugin": { "id": "com.resonance.reverb" },
  "meta": {
    "name": "Snare Tight",
    "author": "Resonance",
    "description": "Tiny Room (0.15 size, 0.45 s) with the bass decay cut to 0.7x and a 200 Hz return HPF: a short, dry snap of natural room on the snare that keeps the kick out, at 20% mix and 70% width.",
